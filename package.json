{
  "name": "markdown-live-preview",
  "version": "1.0.0",
  "description": "Markdown and JSON editor with live preview: code highlighting, search, outline, share links, offline support and a responsive layout.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "update:css-version": "node scripts/update-css-version.mjs",
    "serve-dist": "http-server dist -p 5001 -c-1",
    "build-and-serve": "npm run build && npm run serve-dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanabe/markdown-live-preview.git"
  },
  "keywords": [
    "markdown",
    "editor",
    "preview",
    "json",
    "mermaid"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tanabe/markdown-live-preview/issues"
  },
  "homepage": "https://github.com/tanabe/markdown-live-preview#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.7",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.52.2",
    "storehouse-js": "github:tanabe/Storehouse-js"
  }
}
